#!/usr/bin/env bash
# Set the ambient agent state.  Usage: agent-ambient <idle|working|needs|done|error>
set -u
S="${1:-idle}"
case "$S" in idle|working|needs|done|error) ;; *) echo "invalid state: $S (idle|working|needs|done|error)" >&2; exit 1;; esac
STATE_DIR="$HOME/.local/state/omarchy"; mkdir -p "$STATE_DIR"
printf '%s' "$S" > "$STATE_DIR/agent-ambient"
# 'done' auto-returns to idle after doneTimeoutMs (validated: 0 < t <= 30s, default 2.5)
if [ "$S" = "done" ]; then
  TMO=$(python3 -c "import json,sys
try: v=float(json.load(open(sys.argv[1])).get('doneTimeoutMs',2500))/1000.0
except Exception: v=2.5
print(v if 0<v<=30 else 2.5)" "$HOME/.config/omarchy/ambient-agent.json" 2>/dev/null || echo 2.5)
  ( sleep "$TMO" 2>/dev/null; printf 'idle' > "$STATE_DIR/agent-ambient" ) &
fi
